# Exactius Configuration
# Choose ONE mode: Multi-Account (production) OR Single-Account (local dev)

# ============================================================================
# MULTI-ACCOUNT MODE (Production - Recommended)
# ============================================================================
# Uses Google Secret Manager for all credentials
# Only requires the Google Cloud project ID
# All account credentials stored securely in Secret Manager

GOOGLE_CLOUD_PROJECT=your-project-id

# ============================================================================
# SINGLE-ACCOUNT MODE (Local Development Only)
# ============================================================================
# Legacy mode for testing with a single ad account
# Uses local environment variables instead of Secret Manager
# NOT recommended for production use

# FB_ACCESS_TOKEN=your_facebook_access_token_here
# FB_APP_ID=your_facebook_app_id
# FB_APP_SECRET=your_facebook_app_secret
# FB_AD_ACCOUNT_ID=act_123456789

# ============================================================================
# OPTIONAL SETTINGS (Both Modes)
# ============================================================================

# Facebook API version
FB_API_VERSION=v19.0

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Asset processing settings
TEMP_DOWNLOAD_DIR=/tmp/exactius-assets
MAX_IMAGE_SIZE_MB=30
MAX_VIDEO_SIZE_MB=4096

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
#
# For Multi-Account Mode (Production):
# 1. Create a Google Cloud project
# 2. Enable Secret Manager API:
#    gcloud services enable secretmanager.googleapis.com
# 3. Set up account secrets in Secret Manager (see docs/google-secret-manager-setup.md)
# 4. Set GOOGLE_CLOUD_PROJECT above
# 5. Authenticate:
#    gcloud auth application-default login
#
# For Single-Account Mode (Local Development):
# 1. Get Facebook Marketing API credentials from developers.facebook.com
# 2. Uncomment and fill in FB_* variables above
# 3. Copy this file to .env
#
# See docs/google-secret-manager-setup.md for detailed setup instructions.
